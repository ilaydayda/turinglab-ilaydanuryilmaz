// Turing Machine State Diagram
digraph {
	rankdir=LR
	node [fontname=Helvetica shape=circle]
	q0 [label=q0 color=blue penwidth=2.0]
	q_back [label=q_back]
	q_carry [label=q_carry]
	q_done [label=q_done]
	q_accept [label=q_accept color=green fillcolor=lightgreen shape=doublecircle style=filled]
	q0 -> q0 [label="0 → 0, R"]
	q0 -> q0 [label="1 → 1, R"]
	q0 -> q_back [label="B → B, L"]
	q_back -> q_done [label="0 → 1, L"]
	q_back -> q_back [label="1 → 0, L"]
	q_back -> q_done [label="B → 1, L"]
	q_done -> q_done [label="0 → 0, L"]
	q_done -> q_done [label="1 → 1, L"]
	q_done -> q_accept [label="B → B, R"]
}
